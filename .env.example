# ============================================================
# Cyberonites MCQ Platform — Environment Configuration (.env)
# ============================================================

# Django Core
SECRET_KEY=change-this-to-a-strong-random-secret-key-in-production
DEBUG=False
DJANGO_SETTINGS_MODULE=quiz_platform.settings.production

# Allowed Hosts (comma-separated domains and public IPs)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,your-ec2-ip,localhost,127.0.0.1

# CSRF Trusted Origins (comma-separated with https://)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://your-ec2-ip

# PostgreSQL Database (AWS RDS or local PostgreSQL)
POSTGRES_DB=cyberonites_db
POSTGRES_USER=cyberonites_user
POSTGRES_PASSWORD=YourStrongDatabasePassword2026!
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# Redis (for Django Channels & Real-Time Proctored Feeds)
REDIS_URL=redis://127.0.0.1:6379/1

# Security & HTTPS
# NOTE: If accessing via HTTP (e.g. EC2 public IP) before setting up domain SSL via Certbot,
# keep these as False. Once Certbot SSL is active on your domain, change all three to True!
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Anti-Cheat & Secure Exam Browser Key (must match secure-app)
SECURE_APP_SECRET=c9f8a2e1-exam-secure-browser-key-x77

# Initial Admin Superuser (created automatically during setup)
ADMIN_EMAIL=admin@cyberonites.com
ADMIN_PASSWORD=YourStrongAdminPassword2026!
